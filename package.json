{
  "name": "bo-sketch-obs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:macos": "npm run tauri build && ./scripts/install-macos.sh",
    "build:install": "npm run build:macos",
    "build:windows": "npm run tauri build -- --bundles nsis,msi",
    "install:windows": "powershell -ExecutionPolicy Bypass -File .\\scripts\\install-windows.ps1",
    "test:pointer": "node --test --experimental-strip-types tests/pointer-input.test.ts",
    "test:canvas": "node --test --experimental-strip-types tests/canvas-navigation.test.ts",
    "test": "npm run test:pointer && npm run test:canvas && npm run test:keyboard && npm run test:agent && npm run test:workspace",
    "test:agent": "node --test --experimental-strip-types tests/board-agent.test.ts",
    "test:keyboard": "node --test --experimental-strip-types tests/keyboard-shortcuts.test.ts",
    "test:workspace": "node --test --experimental-strip-types tests/workspace-storage.test.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "autolinker": "^4.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "motion": "^13.1.1",
    "react": "^19.0.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tldraw": "^5.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
