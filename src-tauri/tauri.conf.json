{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BoSketchObs",
  "version": "0.1.0",
  "identifier": "com.rahul.bosketchobs",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "BoSketchObs",
        "width": 1200,
        "height": 700,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGRUYwMTFFRTI0QTcyNjIKUldSaWNrcmlIZ0h2bnoxWTJqd2hmZUliOHhEb2o0OUdQak8zS1NXVUJqVXdBYlB4TG9PNmt2bzAK",
      "endpoints": [
        "https://github.com/OWNER/BoSketchObs/releases/latest/download/latest.json"
      ]
    }
  }
}
